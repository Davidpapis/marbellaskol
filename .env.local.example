# Credenciales API de OwnerRez (HTTP Basic Authentication)
# Se obtienen en OwnerRez -> Settings -> API Access -> Personal Access Tokens
OWNERREZ_API_USER="skol@marbellaskol.com"
OWNERREZ_API_TOKEN="pt_xxxxxxxxxxxxxxxxxxxxxxxx"

# URL base oficial de producción de OwnerRez
OWNERREZ_API_BASE_URL="https://secure.ownerreservations.com/api/"

# Reseñas en vivo de Google Business Profile (opcional — Places API New)
# GOOGLE_PLACES_API_KEY="AIzaSy..."
# GOOGLE_PLACE_ID="ChIJ..."

# Keystatic en producción (opcional, solo cuando se conecte con GitHub App)
# KEYSTATIC_GITHUB_CLIENT_ID=""
# KEYSTATIC_GITHUB_CLIENT_SECRET=""
# KEYSTATIC_SECRET=""
