---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Cookies Policy | MarbellaSkol" description="Cookies policy for MarbellaSkol." canonicalPath="/cookies" noindex={true}>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-semibold text-ink">Cookies Policy</h1>
    <div class="mt-6 space-y-4 text-sm leading-relaxed text-ink-muted">
      <p>This website uses strictly necessary technical cookies to operate the real-time OwnerRez availability search and booking widgets. We do not use intrusive third-party advertising trackers.</p>
    </div>
  </section>
</BaseLayout>
