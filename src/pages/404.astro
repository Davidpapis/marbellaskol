---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Page Not Found | MarbellaSkol"
  description="The page you are looking for could not be found."
  canonicalPath="/404"
  noindex={true}
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center">
    <p class="font-mono text-sm font-semibold tracking-widest text-terracotta uppercase">404</p>
    <h1 class="mt-3 text-4xl font-semibold text-ink">Page not found</h1>
    <p class="mt-4 max-w-md text-base text-ink-muted">
      The apartment or page you requested has moved or is no longer available.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="btn-tactile rounded-full bg-sea px-6 py-3 text-sm font-semibold text-white hover:bg-sea-dark"
      >
        Back to Home
      </a>
      <a
        href="/es"
        class="btn-tactile rounded-full border border-sand-300 bg-surface px-6 py-3 text-sm font-semibold text-ink hover:border-sea"
      >
        Ir a Inicio (ES)
      </a>
    </div>
  </section>
</BaseLayout>
