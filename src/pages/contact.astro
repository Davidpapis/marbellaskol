---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/islands/ContactForm';
import contactPage from '../content/singletons/contact-page.json';
import siteSettings from '../content/singletons/site-settings.json';
---

<BaseLayout
  lang="en"
  title="Contact MarbellaSkol | Direct Beachfront Rentals"
  description="Contact MarbellaSkol directly for beachfront apartments in Edificio Skol and central Marbella. Phone, WhatsApp and quick enquiry form."
  canonicalPath="/contact"
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-xs font-semibold tracking-[0.14em] text-terracotta uppercase">Marbella Centre</p>
        <h1 class="mt-2 text-4xl font-semibold text-ink">{contactPage.titleEn}</h1>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">{contactPage.introEn}</p>

        <div class="mt-8 space-y-4 rounded-2xl border border-sand-200 bg-surface p-6 text-sm">
          <div>
            <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Mobile & WhatsApp</p>
            <a href={`tel:${siteSettings.phoneMobile.replace(/\s+/g, '')}`} class="mt-1 block font-mono text-base font-semibold text-sea">
              {siteSettings.phoneMobile}
            </a>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Office Phone</p>
            <a href={`tel:${siteSettings.phoneLandline.replace(/\s+/g, '')}`} class="mt-1 block font-mono text-base font-semibold text-ink">
              {siteSettings.phoneLandline}
            </a>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Email</p>
            <a href={`mailto:${siteSettings.email}`} class="mt-1 block font-medium text-sea">
              {siteSettings.email}
            </a>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wider text-ink-muted uppercase">Hours</p>
            <p class="mt-1 text-ink-muted">{contactPage.officeHoursEn}</p>
          </div>
          <a
            href={`https://wa.me/${siteSettings.whatsappNumber}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-tactile mt-2 inline-flex w-full items-center justify-center rounded-full bg-saving px-5 py-3 text-sm font-semibold text-white hover:opacity-95"
          >
            Chat on WhatsApp
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ContactForm lang="en" client:load />
      </div>
    </div>
  </section>
</BaseLayout>
