---
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const team = [
  {
    name: 'Kathy Carrasco',
    roleEn: 'General Manager',
    roleEs: 'Directora General',
    phone: '+34 649 971 047',
    email: 'kathy@marbellaskol.com',
    photo: '/images/team/kathy.jpg',
  },
  {
    name: 'Noemi Conde',
    roleEn: 'Manager Assistant',
    roleEs: 'Asistente de Dirección',
    phone: '+34 682 808 047',
    email: 'noemi@marbellaskol.com',
    photo: '/images/team/noemi.jpg',
  },
  {
    name: 'Anabel Espada',
    roleEn: 'Maintenance Coordinator',
    roleEs: 'Coordinadora de Mantenimiento',
    phone: '+34 648 212 763',
    email: 'info@marbellaskol.com',
    photo: '/images/team/anabel.png',
  },
  {
    name: 'Lucy',
    roleEn: 'Guest Experience Assistant',
    roleEs: 'Atención al Huésped',
    phone: '+34 682 808 047',
    email: 'skol@marbellaskol.com',
    photo: '/images/team/lucy.jpg',
  },
  {
    name: 'Laura',
    roleEn: 'Guest Experience Assistant',
    roleEs: 'Atención al Huésped',
    phone: '+34 682 808 047',
    email: 'skol@marbellaskol.com',
    photo: '/images/team/laura.jpg',
  },
];
---

<section class="border-t border-[#DCE8F2] bg-white py-18 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="text-xs font-bold tracking-[0.16em] text-[#199bd1] uppercase">
        {lang === 'es' ? 'Equipo Presencial en Marbella' : 'On-Site Local Team in Marbella'}
      </p>
      <h2 class="mt-2 font-serif text-3xl font-semibold text-[#0B2239] sm:text-4xl">
        {lang === 'es' ? 'Conoce a nuestro equipo' : 'Meet Our Marbella Team'}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-[#4A6278] sm:text-base">
        {lang === 'es'
          ? 'Trato humano, cercano y presencial en el propio Edificio Skol. Te acompañamos desde la reserva hasta tu regreso a casa.'
          : 'Personal, on-site hospitality right inside Edificio Skol. Real local specialists supporting you from booking to check-out.'}
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {team.map((member, idx) => (
        <article
          data-reveal
          style={`--reveal-delay: ${idx * 65}ms`}
          class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-[#DCE8F2] bg-[#F8FBFD] text-center shadow-xs"
        >
          <div class="relative aspect-[4/3] overflow-hidden bg-[#E7F4FC]">
            <img
              src={member.photo}
              alt={`${member.name} — ${lang === 'es' ? member.roleEs : member.roleEn}`}
              loading="lazy"
              class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
            />
          </div>
          <div class="flex flex-1 flex-col p-4">
            <h3 class="font-serif text-lg font-semibold text-[#0B2239]">{member.name}</h3>
            <p class="mt-0.5 text-xs font-semibold text-[#199bd1]">
              {lang === 'es' ? member.roleEs : member.roleEn}
            </p>
            <div class="mt-4 flex flex-col gap-1.5 border-t border-[#E3EEF7] pt-3 text-xs text-[#4A6278]">
              <a
                href={`tel:${member.phone.replace(/\s+/g, '')}`}
                class="font-mono font-medium text-[#0B2239] transition-colors hover:text-[#0B6FA4]"
              >
                {member.phone}
              </a>
              <a
                href={`mailto:${member.email}`}
                class="truncate transition-colors hover:text-[#0B6FA4]"
              >
                {member.email}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
