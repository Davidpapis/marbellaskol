---
import siteSettings from '../content/singletons/site-settings.json';
import type { Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  unitCode: string;
  ownerrezPropertyId: number;
  propertyUuid?: string;
  calendarWidgetIdEn?: string;
  calendarWidgetIdEs?: string;
  bookingWidgetIdEn?: string;
  bookingWidgetIdEs?: string;
  reviewWidgetId?: string;
  mode: 'booking' | 'calendar' | 'reviews';
}

const {
  lang,
  unitCode,
  propertyUuid = '',
  calendarWidgetIdEn = '',
  calendarWidgetIdEs = '',
  bookingWidgetIdEn = '',
  bookingWidgetIdEs = '',
  reviewWidgetId = '',
  mode,
} = Astro.props;

const bookingId =
  lang === 'es'
    ? bookingWidgetIdEs || bookingWidgetIdEn
    : bookingWidgetIdEn || bookingWidgetIdEs;

const calendarId =
  lang === 'es'
    ? calendarWidgetIdEs || calendarWidgetIdEn
    : calendarWidgetIdEn || calendarWidgetIdEs;

const whatsappText = encodeURIComponent(
  lang === 'es'
    ? `Hola MarbellaSkol, me interesa consultar disponibilidad para ${unitCode}.`
    : `Hello MarbellaSkol, I would like to check availability for ${unitCode}.`
);
const whatsappHref = `https://wa.me/${siteSettings.whatsappNumber}?text=${whatsappText}`;
---

{mode === 'booking' ? (
  <div class="rounded-3xl border border-[#DCE8F2] bg-white p-5 shadow-lg shadow-[#064273]/8">
    <div class="mb-4 flex items-center justify-between gap-2 border-b border-[#EBF3FA] pb-3.5">
      <div>
        <p class="text-[11px] font-bold tracking-[0.12em] text-[#0D7A67] uppercase">
          {lang === 'es' ? 'Reserva Directa Protegida' : 'Protected Direct Booking'}
        </p>
        <h2 class="mt-0.5 font-serif text-xl font-semibold text-[#0B2239]">
          {lang === 'es' ? 'Precio Oficial y Reserva' : 'Live Quote & Instant Booking'}
        </h2>
      </div>
      <span class="rounded-full bg-[#E6F6F2] px-2.5 py-1 text-[11px] font-bold text-[#0D7A67]">
        0% OTA
      </span>
    </div>

    {bookingId ? (
      <div class="ownerrez-container min-h-[380px]">
        <div
          class="ownerrez-widget"
          data-propertyid={propertyUuid || undefined}
          data-widget-type="Booking/Inquiry"
          data-widgetid={bookingId}
        />
      </div>
    ) : (
      <div class="space-y-4 rounded-xl bg-[#F3F8FC] p-4 text-sm text-[#4A6278]">
        <p>
          {lang === 'es'
            ? `Consulta disponibilidad y tarifa directa para ${unitCode} directamente con nuestro equipo en Marbella.`
            : `Check live availability and direct rates for ${unitCode} with our local Marbella team.`}
        </p>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-tactile flex h-11 w-full items-center justify-center rounded-full bg-[#199bd1] px-5 text-sm font-semibold text-white hover:bg-[#0B6FA4]"
        >
          {lang === 'es' ? 'Consultar por WhatsApp' : 'Enquire via WhatsApp'}
        </a>
      </div>
    )}

    <div class="mt-4 space-y-2.5 border-t border-[#EBF3FA] pt-3.5">
      <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] font-semibold text-[#0B2239]">
        <span class="inline-flex items-center gap-1 text-[#0D7A67]">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          {lang === 'es' ? 'Pago SSL 256-bit' : 'SSL 256-bit Encrypted'}
        </span>
        <div class="flex items-center gap-1.5 font-mono text-[10px] text-[#4A6278]">
          <span class="rounded border border-[#DCE8F2] bg-[#F8FBFD] px-1.5 py-0.5 font-bold text-[#0B2239]">VISA</span>
          <span class="rounded border border-[#DCE8F2] bg-[#F8FBFD] px-1.5 py-0.5 font-bold text-[#0B2239]">Mastercard</span>
          <span class="rounded border border-[#DCE8F2] bg-[#F8FBFD] px-1.5 py-0.5 font-bold text-[#0B6FA4]">PayPal</span>
        </div>
      </div>
      <p class="text-[11px] leading-relaxed text-[#4A6278]">
        {lang === 'es'
          ? 'Confirmación inmediata, mejor precio directo garantizado y soporte presencial en el Edificio Skol.'
          : 'Instant confirmation, best direct rate guaranteed and on-site assistance in Edificio Skol.'}
      </p>
    </div>
  </div>
) : mode === 'calendar' ? (
  calendarId && (
    <section class="rounded-3xl border border-[#DCE8F2] bg-white p-6 shadow-xs">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="text-[11px] font-bold tracking-[0.14em] text-[#199bd1] uppercase">
            {lang === 'es' ? 'Tarifas Diarias y Disponibilidad' : 'Latest Availability & Nightly Rates'}
          </p>
          <h2 class="mt-1 font-serif text-2xl font-semibold text-[#0B2239]">
            {lang === 'es' ? `Calendario de ${unitCode}` : `${unitCode} Availability Calendar`}
          </h2>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E6F6F2] px-3 py-1 text-xs font-semibold text-[#0D7A67]">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0D7A67]" aria-hidden="true" />
          {lang === 'es' ? 'Actualizado al instante' : 'Live Updated'}
        </span>
      </div>
      <div class="ownerrez-container mt-5 min-h-[300px]">
        <div
          class="ownerrez-widget"
          data-propertyid={propertyUuid || undefined}
          data-widget-type="Multiple Month Calendar"
          data-widgetid={calendarId}
        />
      </div>
    </section>
  )
) : (
  reviewWidgetId && (
    <section class="rounded-3xl border border-[#DCE8F2] bg-white p-6 shadow-xs">
      <p class="text-[11px] font-bold tracking-[0.14em] text-[#199bd1] uppercase">
        {lang === 'es' ? 'Opiniones Verificadas' : 'Verified Guest Reviews'}
      </p>
      <h2 class="mt-1 font-serif text-2xl font-semibold text-[#0B2239]">
        {lang === 'es' ? `Qué opinan nuestros huéspedes de ${unitCode}` : `Guest Reviews for ${unitCode}`}
      </h2>
      <div class="ownerrez-container mt-5 min-h-[200px]">
        <div
          class="ownerrez-widget"
          data-propertyid={propertyUuid || undefined}
          data-widget-type="Reviews"
          data-widgetid={reviewWidgetId}
        />
      </div>
    </section>
  )
)}
