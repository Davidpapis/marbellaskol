---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyGallery from './islands/PropertyGallery';
import PropertyMap from './islands/PropertyMap';
import OwnerRezWidgets from './OwnerRezWidgets.astro';
import HouseRules from './HouseRules.astro';
import siteSettings from '../content/singletons/site-settings.json';
import { getCategoryLabel, toPropertyCard, type PropertyEntry } from '../lib/properties';
import type { Lang } from '../lib/i18n';

interface Props {
  property: PropertyEntry;
  lang: Lang;
}

const { property, lang } = Astro.props;
const d = property.data;
const localized = lang === 'es' ? d.contentEs : d.contentEn;
const listHref = lang === 'es' ? '/es/propiedades' : '/properties';
const canonicalPath =
  lang === 'es' ? `/es/propiedades/${d.slug}` : `/properties/${d.slug}`;

const seoTitle = `${d.unitCode} | ${localized.title}`.slice(0, 60);
const seoDesc = (
  localized.summary ||
  (lang === 'es'
    ? `Alquiler vacacional directo ${d.unitCode} en ${d.building}, ${d.zone}. ${d.bedrooms} dormitorios, hasta ${d.maxGuests} huéspedes.`
    : `Direct holiday rental ${d.unitCode} in ${d.building}, ${d.zone}. ${d.bedrooms} bedrooms, up to ${d.maxGuests} guests.`)
).slice(0, 160);

const images = d.gallery.length > 0 ? d.gallery : d.coverImage ? [d.coverImage] : ['/images/hero-skol.jpg'];
const paragraphs = localized.description
  .split(/\n+/)
  .map((p) => p.trim())
  .filter(Boolean);

const hasAnyWidget = Boolean(
  d.ownerrez.bookingWidgetIdEn ||
    d.ownerrez.bookingWidgetIdEs ||
    d.ownerrez.calendarWidgetIdEn ||
    d.ownerrez.calendarWidgetIdEs ||
    d.ownerrez.reviewWidgetId
);

// Apartamentos similares sugeridos (mismo edificio / tipología / dormitorios)
const allActive = await getCollection('properties', ({ data }) => data.isActive && data.slug !== d.slug);
const suggested = allActive
  .map((item) => {
    let score = 0;
    if (item.data.building === d.building) score += 4;
    if (item.data.category === d.category) score += 3;
    if (item.data.bedrooms === d.bedrooms) score += 2;
    if (item.data.featured) score += 1;
    return { item, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ item }) => toPropertyCard(item, lang));

const schemas = [
  {
    '@type': 'VacationRental',
    name: localized.title,
    identifier: d.vftLicense || d.internalRef || d.unitCode,
    description: seoDesc,
    image: images.slice(0, 5),
    containsPlace: {
      '@type': 'Accommodation',
      occupancy: { '@type': 'QuantitativeValue', value: d.maxGuests },
      numberOfBedrooms: d.bedrooms,
      numberOfBathroomsTotal: d.bathrooms,
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: d.location.address,
      addressLocality: 'Marbella',
      addressRegion: 'Málaga',
      addressCountry: 'ES',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: d.location.latitude,
      longitude: d.location.longitude,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: siteSettings.brandName,
        item: `${siteSettings.domain}${lang === 'es' ? '/es' : '/'}`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: lang === 'es' ? 'Apartamentos' : 'Apartments',
        item: `${siteSettings.domain}${listHref}`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: d.unitCode,
        item: `${siteSettings.domain}${canonicalPath}`,
      },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  title={seoTitle}
  description={seoDesc}
  canonicalPath={canonicalPath}
  ogImage={images[0]}
  schemas={schemas}
>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <article class="bg-[#F8FBFD]">
    <!-- Franja blanca superior con Breadcrumb + Mosaico 5 fotos a ancho completo -->
    <div class="border-b border-[#DCE8F2] bg-white">
      <div class="mx-auto max-w-7xl px-4 pt-6 pb-8 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-medium text-[#4A6278]">
          <a href={lang === 'es' ? '/es' : '/'} class="hover:text-[#0B6FA4]">
            {lang === 'es' ? 'Inicio' : 'Home'}
          </a>
          <span aria-hidden="true">/</span>
          <a href={listHref} class="hover:text-[#0B6FA4]">
            {lang === 'es' ? 'Apartamentos' : 'Apartments'}
          </a>
          <span aria-hidden="true">/</span>
          <span class="font-semibold text-[#0B2239]">{d.unitCode}</span>
        </nav>

        <PropertyGallery images={images} title={localized.title} lang={lang} client:load />

        <!-- Badges + Titular H1 + Dirección -->
        <div class="mt-6 flex flex-wrap items-center gap-2">
          {d.featured && (
            <span class="rounded-md bg-amber-500 px-2.5 py-1 text-xs font-bold text-white shadow-2xs">
              ★ {lang === 'es' ? 'Destacado' : 'Featured'}
            </span>
          )}
          <span class="rounded-md bg-[#199bd1] px-2.5 py-1 text-xs font-semibold text-white">
            {lang === 'es' ? 'Alquiler Vacacional' : 'Holiday Rentals'}
          </span>
          <span class="rounded-md bg-[#0D7A67] px-2.5 py-1 text-xs font-semibold text-white">
            {getCategoryLabel(d.category, lang)}
          </span>
          <span class="rounded-md bg-[#E7F4FC] px-2.5 py-1 font-mono text-xs font-semibold text-[#0B6FA4]">
            {d.unitCode}
          </span>
          {d.vftLicense && (
            <span class="rounded-md border border-[#DCE8F2] bg-[#F3F8FC] px-2.5 py-1 font-mono text-xs text-[#4A6278]">
              {d.vftLicense}
            </span>
          )}
        </div>

        <h1 class="mt-3 max-w-4xl text-3xl leading-tight font-semibold text-[#0B2239] sm:text-4xl">
          {localized.title}
        </h1>
        <p class="mt-2 text-sm text-[#4A6278]">
          📍 {d.location.address} · {d.building}, {d.zone}
        </p>

        <!-- Barra de resumen de especificaciones con iconos -->
        <div class="mt-6 grid grid-cols-2 gap-3 rounded-xl border border-[#DCE8F2] bg-[#F3F8FC] p-4 sm:grid-cols-4">
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold tracking-wider text-[#4A6278] uppercase">
              {lang === 'es' ? 'Dormitorios' : 'Bedrooms'}
            </span>
            <span class="mt-1 font-mono text-base font-semibold text-[#0B2239] tabular-nums">
              {d.bedrooms === 0 ? (lang === 'es' ? 'Estudio' : 'Studio') : d.bedrooms}
            </span>
          </div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold tracking-wider text-[#4A6278] uppercase">
              {lang === 'es' ? 'Baños' : 'Bathrooms'}
            </span>
            <span class="mt-1 font-mono text-base font-semibold text-[#0B2239] tabular-nums">
              {d.bathrooms}
            </span>
          </div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold tracking-wider text-[#4A6278] uppercase">
              {lang === 'es' ? 'Capacidad Máx.' : 'Max Guests'}
            </span>
            <span class="mt-1 font-mono text-base font-semibold text-[#0B2239] tabular-nums">
              {d.maxGuests} {lang === 'es' ? 'personas' : 'guests'}
            </span>
          </div>
          <div class="flex flex-col">
            <span class="text-[11px] font-semibold tracking-wider text-[#4A6278] uppercase">
              {lang === 'es' ? 'Referencia / VFT' : 'Ref / Licence'}
            </span>
            <span class="mt-1 truncate font-mono text-sm font-semibold text-[#0B6FA4]">
              {d.vftLicense || d.internalRef || d.unitCode}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido principal + Sticky OwnerRez Booking Widget -->
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.45fr)_minmax(360px,0.9fr)] lg:items-start">
        <div class="space-y-8">
          <!-- Descripción completa -->
          <section class="rounded-2xl border border-[#DCE8F2] bg-white p-6 shadow-xs sm:p-8">
            <h2 class="font-serif text-2xl font-semibold text-[#0B2239]">
              {lang === 'es' ? 'Descripción del Apartamento' : 'Description'}
            </h2>
            <div class="mt-4 space-y-3 text-sm leading-relaxed text-[#334E68] sm:text-base">
              {paragraphs.length > 0 ? (
                paragraphs.map((p) => <p>{p}</p>)
              ) : (
                <p>{localized.summary}</p>
              )}
            </div>
          </section>

          <!-- Calendario oficial OwnerRez con precios por noche -->
          <OwnerRezWidgets
            lang={lang}
            unitCode={d.unitCode}
            ownerrezPropertyId={d.ownerrez.propertyId}
            propertyUuid={d.ownerrez.propertyUuid}
            calendarWidgetIdEn={d.ownerrez.calendarWidgetIdEn}
            calendarWidgetIdEs={d.ownerrez.calendarWidgetIdEs}
            bookingWidgetIdEn={d.ownerrez.bookingWidgetIdEn}
            bookingWidgetIdEs={d.ownerrez.bookingWidgetIdEs}
            mode="calendar"
          />

          <!-- Equipamiento y Servicios -->
          {localized.amenities.length > 0 && (
            <section class="rounded-2xl border border-[#DCE8F2] bg-white p-6 shadow-xs sm:p-8">
              <h2 class="font-serif text-2xl font-semibold text-[#0B2239]">
                {lang === 'es' ? 'Equipamiento y Servicios' : 'Features & Amenities'}
              </h2>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
                {localized.amenities.map((item) => (
                  <li class="flex items-center gap-2 text-sm text-[#334E68]">
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E7F4FC] text-xs font-bold text-[#0B6FA4]" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Mapa interactivo gratuito de ubicación -->
          <PropertyMap
            lang={lang}
            unitCode={d.unitCode}
            address={d.location.address}
            building={d.building}
            latitude={d.location.latitude}
            longitude={d.location.longitude}
            client:visible
          />

          <!-- Normas de la Casa + Fianza 300 € -->
          <HouseRules lang={lang} />

          <!-- Opiniones Verificadas (si la propiedad dispone de widget de reseñas) -->
          <OwnerRezWidgets
            lang={lang}
            unitCode={d.unitCode}
            ownerrezPropertyId={d.ownerrez.propertyId}
            propertyUuid={d.ownerrez.propertyUuid}
            reviewWidgetId={d.ownerrez.reviewWidgetId}
            mode="reviews"
          />
        </div>

        <!-- Columna derecha sticky: Widget Oficial Book/Inquire -->
        <aside class="lg:sticky lg:top-24">
          <OwnerRezWidgets
            lang={lang}
            unitCode={d.unitCode}
            ownerrezPropertyId={d.ownerrez.propertyId}
            propertyUuid={d.ownerrez.propertyUuid}
            calendarWidgetIdEn={d.ownerrez.calendarWidgetIdEn}
            calendarWidgetIdEs={d.ownerrez.calendarWidgetIdEs}
            bookingWidgetIdEn={d.ownerrez.bookingWidgetIdEn}
            bookingWidgetIdEs={d.ownerrez.bookingWidgetIdEs}
            mode="booking"
          />
        </aside>
      </div>

      <!-- Apartamentos Similares Sugeridos -->
      {suggested.length > 0 && (
        <section class="mt-16 border-t border-[#DCE8F2] pt-12">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-xs font-bold tracking-[0.14em] text-[#199bd1] uppercase">
                {lang === 'es' ? 'También te puede gustar' : 'You May Also Like'}
              </p>
              <h2 class="mt-1 font-serif text-2xl font-semibold text-[#0B2239] sm:text-3xl">
                {lang === 'es' ? 'Apartamentos Similares Sugeridos' : 'Similar Suggested Apartments'}
              </h2>
            </div>
            <a href={listHref} class="text-xs font-bold text-[#0B6FA4] hover:text-[#199bd1]">
              {lang === 'es' ? 'Ver todo el catálogo →' : 'View full catalogue →'}
            </a>
          </div>

          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {suggested.map((item) => (
              <article class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-[#DCE8F2] bg-white shadow-xs">
                <a href={item.href} class="relative block aspect-[16/10] overflow-hidden bg-[#E7F4FC]">
                  <img
                    src={item.coverImage}
                    alt={item.title}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                  {item.featured && (
                    <span class="absolute top-3 left-3 rounded-md bg-amber-500 px-2.5 py-0.5 text-[11px] font-bold text-white shadow-xs">
                      ★ {lang === 'es' ? 'Destacado' : 'Featured'}
                    </span>
                  )}
                  <span class="absolute top-3 right-3 rounded-md bg-[#199bd1]/95 px-2.5 py-0.5 font-mono text-[11px] font-bold text-white">
                    {item.unitCode}
                  </span>
                </a>
                <div class="flex flex-1 flex-col p-5">
                  <p class="text-xs font-medium text-[#199bd1]">
                    {item.building} · {item.zone}
                  </p>
                  <h3 class="mt-1.5 line-clamp-2 font-serif text-lg font-semibold text-[#0B2239]">
                    <a href={item.href} class="hover:text-[#0B6FA4]">
                      {item.title}
                    </a>
                  </h3>
                  <div class="mt-auto flex items-center gap-4 border-t border-[#EBF3FA] pt-3.5 mt-4 text-xs font-semibold text-[#334E68] tabular-nums">
                    <span>🛏 {item.bedrooms === 0 ? (lang === 'es' ? 'Estudio' : 'Studio') : item.bedrooms}</span>
                    <span>🛁 {item.bathrooms}</span>
                    <span>👥 {item.maxGuests}</span>
                    <a href={item.href} class="ml-auto text-[#0B6FA4] hover:text-[#199bd1]">
                      {lang === 'es' ? 'Ver →' : 'View →'}
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  <!-- Carga ÚNICA del script oficial v2 (app.ownerrez.com/widget.js) tras existir los contenedores -->
  {hasAnyWidget && (
    <script is:inline src="https://app.ownerrez.com/widget.js"></script>
  )}
</BaseLayout>
