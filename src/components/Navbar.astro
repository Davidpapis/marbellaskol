---
import siteSettings from '../content/singletons/site-settings.json';
import MarbellaWeather from './islands/MarbellaWeather';
import { getAlternatePath, NAV_ITEMS, normalizePath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const navItems = NAV_ITEMS[lang];
const normCurrent = normalizePath(currentPath);
const enHref = getAlternatePath(currentPath, 'en');
const esHref = getAlternatePath(currentPath, 'es');
const ctaLabel = lang === 'es' ? 'Ver Disponibilidad' : 'Check Availability';
const ctaHref = lang === 'es' ? '/es/propiedades' : '/properties';
---

<!-- Barra superior azul Mediterráneo CENTRADA con 3 burbujitas (Teléfono · Email · WhatsApp) -->
<div class="bg-gradient-to-r from-[#064273] via-[#0B6FA4] to-[#064273] text-white">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-2.5 px-4 py-2 text-xs font-semibold sm:px-6 lg:px-8">
    <a
      href={`tel:${siteSettings.phoneMobile.replace(/\s+/g, '')}`}
      class="btn-tactile inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-1 text-white backdrop-blur-xs transition-colors hover:bg-white/25"
    >
      <svg id="topbar-icon-phone" class="h-3.5 w-3.5 text-[#7DD3FC]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span class="tabular-nums">{siteSettings.phoneMobile}</span>
    </a>

    <a
      href={`mailto:${siteSettings.email}`}
      class="btn-tactile hidden items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-1 text-white backdrop-blur-xs transition-colors hover:bg-white/25 sm:inline-flex"
    >
      <svg id="topbar-icon-mail" class="h-3.5 w-3.5 text-[#7DD3FC]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
      <span>{siteSettings.email}</span>
    </a>

    <a
      href={`https://wa.me/${siteSettings.whatsappNumber}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-tactile inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3.5 py-1 text-white backdrop-blur-xs transition-colors hover:bg-white/25"
    >
      <svg id="topbar-icon-wa" class="h-3.5 w-3.5 text-[#6EE7B7]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
</div>

<!-- Cabecera principal blanco puro con logo oficial + Tiempo real en Marbella -->
<header class="glass-header sticky top-0 z-40 border-b border-[#DCE8F2] bg-white/95 shadow-xs backdrop-blur-md">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href={lang === 'es' ? '/es' : '/'}
      class="group relative flex shrink-0 items-center focus-visible:outline-sea"
      aria-label={siteSettings.brandName}
    >
      <span class="relative block h-11 w-[166px] sm:h-12 sm:w-[182px]">
        <!-- Capa izquierda: barquito con suave vaivén mediterráneo -->
        <img
          src="/images/marbellaskol-logo.png"
          alt=""
          aria-hidden="true"
          width="210"
          height="58"
          class="logo-boat-layer pointer-events-none absolute inset-0 h-full w-full object-contain object-left"
        />
        <!-- Capa derecha: tipografía fija nítida -->
        <img
          src="/images/marbellaskol-logo.png"
          alt="MarbellaSkol Holiday Rentals Marbella"
          width="210"
          height="58"
          class="logo-text-layer relative h-full w-full object-contain object-left"
        />
      </span>
    </a>

    <nav
      aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}
      class="hidden items-center gap-2 lg:flex"
    >
      {navItems.map((item) => {
        const isActive = normCurrent === normalizePath(item.href);
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'nav-link-slide px-3.5 py-2 text-sm font-semibold transition-colors duration-150',
              isActive
                ? 'text-[#0B6FA4]'
                : 'text-[#0B2239] hover:text-[#0B6FA4]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2.5">
      <MarbellaWeather lang={lang} client:load />

      <!-- Selector de idioma solo con banderitas circulares SVG nítidas -->
      <div
        class="inline-flex items-center gap-2"
        role="group"
        aria-label={lang === 'es' ? 'Selector de idioma' : 'Language switcher'}
      >
        <a
          href={enHref}
          aria-current={lang === 'en' ? 'true' : undefined}
          aria-label="English"
          title="English"
          class:list={[
            'btn-tactile flex h-7 w-7 items-center justify-center overflow-hidden rounded-full transition-all duration-150',
            lang === 'en'
              ? 'ring-2 ring-[#199bd1] shadow-sm'
              : 'opacity-65 ring-1 ring-black/10 hover:opacity-100',
          ]}
        >
          <svg class="h-full w-full shrink-0" viewBox="0 0 60 60" aria-hidden="true">
            <rect width="60" height="60" fill="#012169" />
            <path d="M0 0L60 60M60 0L0 60" stroke="#FFF" stroke-width="10" />
            <path d="M0 0L60 60M60 0L0 60" stroke="#C8102E" stroke-width="5" />
            <path d="M30 0V60M0 30H60" stroke="#FFF" stroke-width="14" />
            <path d="M30 0V60M0 30H60" stroke="#C8102E" stroke-width="8" />
          </svg>
        </a>
        <a
          href={esHref}
          aria-current={lang === 'es' ? 'true' : undefined}
          aria-label="Español"
          title="Español"
          class:list={[
            'btn-tactile flex h-7 w-7 items-center justify-center overflow-hidden rounded-full transition-all duration-150',
            lang === 'es'
              ? 'ring-2 ring-[#199bd1] shadow-sm'
              : 'opacity-65 ring-1 ring-black/10 hover:opacity-100',
          ]}
        >
          <svg class="h-full w-full shrink-0" viewBox="0 0 60 60" aria-hidden="true">
            <rect width="60" height="60" fill="#AA151B" />
            <rect y="15" width="60" height="30" fill="#F1BF00" />
            <rect x="13" y="23" width="8" height="14" rx="2" fill="#AA151B" />
          </svg>
        </a>
      </div>

      <a
        href={ctaHref}
        class="btn-tactile btn-shimmer hidden rounded-full bg-gradient-to-r from-[#199bd1] to-[#0B6FA4] px-4 py-2.5 text-xs font-semibold text-white shadow-sm hover:from-[#0B6FA4] hover:to-[#064273] sm:inline-flex"
      >
        {ctaLabel}
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
        class="btn-tactile flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border border-[#DCE8F2] bg-[#F3F8FC] text-[#0B2239] lg:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable móvil -->
  <div
    id="mobile-nav-drawer"
    hidden
    class="border-t border-[#DCE8F2] bg-white px-4 py-4 shadow-lg lg:hidden"
  >
    <nav class="flex flex-col gap-1.5" aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}>
      {navItems.map((item) => (
        <a
          href={item.href}
          class="rounded-xl px-4 py-3 text-sm font-semibold text-[#0B2239] transition-colors hover:bg-[#F3F8FC] hover:text-[#0B6FA4]"
        >
          {item.label}
        </a>
      ))}
      <a
        href={ctaHref}
        class="btn-tactile mt-2 flex h-11 items-center justify-center rounded-full bg-[#199bd1] px-5 text-sm font-semibold text-white"
      >
        {ctaLabel}
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-toggle');
    var drawer = document.getElementById('mobile-nav-drawer');
    if (!btn || !drawer) return;
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      drawer.hidden = expanded;
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !drawer.hidden) {
        btn.setAttribute('aria-expanded', 'false');
        drawer.hidden = true;
      }
    });

    // Micro-animación sutil aleatoria cada ~16-22s en uno de los 3 iconos de la barra superior
    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var targets = [
        { id: 'topbar-icon-phone', cls: 'anim-phone-ring' },
        { id: 'topbar-icon-mail', cls: 'anim-mail-drop' },
        { id: 'topbar-icon-wa', cls: 'anim-wa-spin' },
      ];
      var lastIdx = -1;
      function pulseRandomIcon() {
        var idx = Math.floor(Math.random() * targets.length);
        if (idx === lastIdx) idx = (idx + 1) % targets.length;
        lastIdx = idx;
        var item = targets[idx];
        var el = document.getElementById(item.id);
        if (el) {
          el.classList.remove(item.cls);
          void el.getBoundingClientRect();
          el.classList.add(item.cls);
          setTimeout(function () {
            el.classList.remove(item.cls);
          }, 700);
        }
        setTimeout(pulseRandomIcon, 2000);
      }
      setTimeout(pulseRandomIcon, 1200);
    }
  })();
</script>
